NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Service role bypasses RLS — used ONLY by /api/cron/send-reminders and
# /api/analytics/beliefs. Get from Supabase dashboard:
# Project Settings -> API -> service_role. Never commit, never prefix
# with NEXT_PUBLIC_, never import outside
# src/lib/supabase/service-role-client.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secrets each protected route checks in its Authorization header.
# Kept separate per route rather than reused, so either can be rotated
# independently. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
ANALYTICS_SECRET=
